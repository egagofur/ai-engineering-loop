{
  "name": "ai-engineering-loop",
  "version": "2.0.0",
  "description": "A visual workspace that helps AI coding agents plan, build, review, and ship reliable software.",
  "main": "bin/ai-engineering-loop.js",
  "bin": {
    "ai-engineering-loop": "bin/ai-engineering-loop.js"
  },
  "files": [
    "bin/",
    "lib/",
    "core/",
    "agents/",
    "policies/",
    "profiles/",
    "adapters/",
    "recipes/",
    "schemas/",
    "studio/",
    "docs/images/",
    "evals/",
    ".agents/",
    ".grok/",
    ".claude/agents/",
    ".claude/skills/",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "CHANGELOG.md",
    "migrations/",
    "SECURITY.md",
    "SUPPORT.md",
    "README.md"
  ],
  "scripts": {
    "init": "node bin/ai-engineering-loop.js",
    "test": "node --test",
    "doctor": "node bin/ai-engineering-loop.js doctor",
    "eval": "node bin/ai-engineering-loop.js eval",
    "audit:package": "node scripts/audit-package.js",
    "verify:release": "node scripts/verify-release.js",
    "prepublishOnly": "npm run check:skills && npm test && npm run doctor && npm run eval && npm run audit:package",
    "build:skills": "node scripts/build-host-skills.js",
    "check:skills": "node scripts/build-host-skills.js --check",
    "build:hosts-table": "node scripts/build-host-table.js",
    "measure": "node scripts/measure.js"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/egagofur/ai-engineering-loop.git"
  },
  "keywords": [
    "ai-agents",
    "agentic-workflow",
    "software-engineering",
    "devils-advocate",
    "verification",
    "autonomous-agents",
    "antigravity",
    "grok",
    "claude-code",
    "subagents"
  ],
  "author": "Ega Gofur",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/egagofur/ai-engineering-loop/issues"
  },
  "homepage": "https://github.com/egagofur/ai-engineering-loop#readme"
}
