{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/egagofur/ai-engineering-loop/schemas/report.schema.json",
  "title": "Report-only completion",
  "type": "object",
  "required": ["schemaVersion", "runId", "summary", "recommendations"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "recommendations": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "additionalProperties": true
}
