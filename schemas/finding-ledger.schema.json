{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/egagofur/ai-engineering-loop/schemas/finding-ledger.schema.json",
  "title": "AI Engineering Loop Finding Ledger",
  "type": "object",
  "required": ["schemaVersion", "runId", "diffHash", "findings"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "diffHash": { "type": "string", "minLength": 1 },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "location", "failureScenario", "evidence", "severity", "validity", "disposition"],
        "properties": {
          "axis": { "enum": ["spec", "standards"] },
          "severity": { "enum": ["BLOCKER", "HIGH", "MEDIUM", "LOW"] },
          "validity": { "enum": ["VALID", "INVALID"] },
          "disposition": { "enum": ["STRONG", "ACCEPTABLE", "WEAK"] },
          "source": { "description": "Producer of a CLI-generated finding, e.g. impact-map for blast-radius drift", "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "rubricScores": {
      "description": "C-09: one score per rubric criterion of a subjective AC",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ac", "criterion", "pass", "evidence"],
        "properties": {
          "ac": { "type": "string", "pattern": "^AC-[0-9]+$" },
          "criterion": { "type": "string", "minLength": 1 },
          "pass": { "type": "boolean" },
          "evidence": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "additionalProperties": true
}
