{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/egagofur/ai-engineering-loop/schemas/goal-contract.schema.json",
  "title": "AI Engineering Loop Goal Contract",
  "type": "object",
  "required": ["schemaVersion", "runId", "objective", "acceptanceCriteria"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "objective": { "type": "string", "minLength": 1 },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "statement", "evidenceRequired", "failureCases"],
        "properties": {
          "id": { "type": "string", "pattern": "^AC-[0-9]+$" },
          "statement": { "type": "string", "minLength": 1 },
          "evidenceRequired": { "type": "string", "minLength": 1 },
          "failureCases": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "additionalProperties": true
      }
    },
    "scope": {
      "description": "Optional file scope frozen with the Goal (#59). Absent = no path enforcement. Globs: ** crosses directories, * stays in one segment, a trailing / is a directory prefix.",
      "type": "object",
      "properties": {
        "allowedPaths": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "deniedPaths": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
