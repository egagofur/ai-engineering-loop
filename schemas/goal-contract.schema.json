{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/egagofur/ai-engineering-loop/schemas/goal-contract.schema.json",
  "title": "AI Engineering Loop Goal Contract",
  "type": "object",
  "required": [
    "schemaVersion",
    "runId",
    "objective",
    "acceptanceCriteria"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "statement",
          "evidenceRequired",
          "failureCases"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^AC-[0-9]+$"
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "evidenceRequired": {
            "type": "string",
            "minLength": 1
          },
          "failureCases": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "rubric": {
            "description": "Optional (C-09) for subjective ACs: criteria the Devil's Advocate scores with evidence in ledger.rubricScores. Judge PASS needs every criterion scored pass:true.",
            "type": "array",
            "items": {
              "type": "object",
              "required": ["criterion", "pass"],
              "properties": {
                "criterion": { "type": "string", "minLength": 1 },
                "pass": { "type": "string", "minLength": 1, "description": "What counts as passing, e.g. 'contrast >= 4.5:1 (WCAG AA)'" }
              }
            }
          },
          "verify": {
            "description": "Optional (C-07, C-23). What proves this AC: an exact `command`, a verification catalog `key` (e.g. pentest, property, formal; default verify runs it when configured), or a `layer` (any passing command of that layer). Gate judge refuses PASS until it passed on the gated diff.",
            "type": "object",
            "anyOf": [
              { "required": ["command"] },
              { "required": ["key"] },
              { "required": ["layer"] }
            ],
            "properties": {
              "command": { "type": "string", "minLength": 1 },
              "key": { "enum": ["build", "typecheck", "lint", "security", "test_unit", "test_related", "test_all", "property", "fuzz", "mutation", "coverage", "benchmark", "smoke", "contract", "e2e", "pentest", "formal"] },
              "layer": { "enum": ["L1", "L2", "L3", "LF"] }
            },
            "additionalProperties": false
          },
          "crossComponent": {
            "description": "Optional (#110). true when the AC crosses a component boundary; claimed-vs-reality then needs L3 (end-to-end) evidence or an 'L3 waived: <reason>' Layer cell before gate review.",
            "type": "boolean"
          }
        },
        "additionalProperties": true
      }
    },
    "scope": {
      "description": "Optional file scope frozen with the Goal (#59). Absent = no path enforcement. Globs: ** crosses directories, * stays in one segment, a trailing / is a directory prefix.",
      "type": "object",
      "properties": {
        "allowedPaths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "deniedPaths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "designRef": {
      "description": "Optional design document this Goal implements (#97): written by `goal draft --from-design`. targetFiles feed the design drift check.",
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "targetFiles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "flow": {
      "description": "Optional (C-21): the intended user flow as transitions. goal draft renders it as a From | Event | To table for the human to check before freeze; the receipt shows it next to the verification artifacts.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["from", "event", "to"],
        "properties": {
          "from": { "type": "string", "minLength": 1 },
          "event": { "type": "string", "minLength": 1 },
          "to": { "type": "string", "minLength": 1 }
        }
      }
    },
    "featureId": {
      "description": "Optional (C-15): id of the feature in .ai-engineering-loop/features.json this Goal delivers. Goal freeze marks it active; delivery marks it passing with this Run as evidence.",
      "type": "string",
      "minLength": 1
    },
    "outOfScope": {
      "description": "Optional list of things this Goal must not change.",
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": true
}
