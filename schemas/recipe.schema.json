{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/egagofur/ai-engineering-loop/schemas/recipe.schema.json",
  "title": "AI Engineering Loop Recipe",
  "type": "object",
  "required": ["schemaVersion", "id", "version", "description", "compatibleModes", "nodes"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "version": { "type": "integer", "minimum": 1 },
    "description": { "type": "string", "minLength": 1 },
    "compatibleModes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["REPORT_ONLY", "ASSISTED", "UNATTENDED"] }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "node-definition.schema.json" }
    },
    "edges": {
      "type": "array",
      "maxItems": 256,
      "items": { "$ref": "edge-definition.schema.json" }
    }
  },
  "additionalProperties": false
}
