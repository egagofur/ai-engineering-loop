{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/egagofur/ai-engineering-loop/schemas/node-definition.schema.json",
  "title": "AI Engineering Loop Node Definition",
  "type": "object",
  "required": ["id", "type"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
    "type": {
      "enum": [
        "goal-contract",
        "agent",
        "command",
        "condition",
        "approval",
        "artifact-check",
        "maker",
        "verification",
        "devil-advocate",
        "judge",
        "report",
        "delivery"
      ]
    },
    "dependsOn": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" }
    },
    "when": { "type": "object" },
    "prompt": { "type": "string", "minLength": 1, "maxLength": 20000 },
    "capabilityRefs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "repository-read",
          "repository-write",
          "artifact-read",
          "artifact-write",
          "mcp-invoke",
          "network-declared"
        ]
      }
    },
    "mcpRefs": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" }
    },
    "inputArtifacts": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" }
    },
    "outputArtifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["artifact", "schema"],
        "properties": {
          "artifact": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
          "schema": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "tokenLimit": { "type": "integer", "minimum": 1, "maximum": 1000000 },
    "timeoutMs": { "type": "integer", "minimum": 1000, "maximum": 1800000 },
    "retry": {
      "type": "object",
      "required": ["maxAttempts", "backoffMs"],
      "properties": {
        "maxAttempts": { "type": "integer", "minimum": 1, "maximum": 10 },
        "backoffMs": { "type": "integer", "minimum": 0, "maximum": 300000 }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": { "const": "agent" },
          "prompt": { "type": "string" }
        },
        "required": ["type", "prompt"]
      },
      "then": {
        "required": [
          "displayName",
          "capabilityRefs",
          "mcpRefs",
          "inputArtifacts",
          "outputArtifacts",
          "tokenLimit",
          "timeoutMs",
          "retry"
        ]
      }
    }
  ],
  "additionalProperties": true
}
