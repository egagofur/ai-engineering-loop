{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/egagofur/ai-engineering-loop/schemas/workflow-state.schema.json",
  "title": "AI Engineering Loop Workflow Runtime State",
  "type": "object",
  "required": ["schemaVersion", "runId", "graphHash", "sequence", "eventHash", "nodes"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "graphHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sequence": { "type": "integer", "minimum": 1 },
    "eventHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "loopGroups": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["status", "iteration", "maxIterations", "updatedAt"],
        "properties": {
          "status": { "enum": ["PENDING", "RUNNING", "BLOCKED", "EXITED", "STOPPED"] },
          "iteration": { "type": "integer", "minimum": 1 },
          "maxIterations": { "type": "integer", "minimum": 1, "maximum": 100 },
          "lastOutcome": { "type": ["string", "null"] },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      }
    },
    "nodes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["status", "attempts", "updatedAt"],
        "properties": {
          "status": {
            "enum": ["PENDING", "READY", "RUNNING", "PASSED", "FAILED", "SKIPPED", "BLOCKED"]
          },
          "attempts": { "type": "integer", "minimum": 0 },
          "loopGroupId": { "type": "string" },
          "loopIteration": { "type": "integer", "minimum": 1 },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      }
    }
  },
  "additionalProperties": false
}
